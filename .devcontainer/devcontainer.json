{
  "name": "Ruby on Rails 7 (SQLite + Bootstrap + jQuery)",
  "image": "mcr.microsoft.com/devcontainers/ruby:1-3.3-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "upgradePackages": true
    }
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Rails Web Server",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y sqlite3 libsqlite3-dev && bundle install && bin/rails db:prepare",

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "misogi.ruby-rubocop"
      ],
      "settings": {
        "rubyLsp.rubyVersionManager": "none",
        "editor.formatOnSave": true
      }
    }
  },

  "remoteUser": "vscode"
}
