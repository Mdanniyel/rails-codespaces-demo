#!/usr/bin/env bash
set -e

echo "=================================================="
echo "🚀 Welcome to Rails Codespaces Onboarding!"
echo "=================================================="

# Ensure SQLite is installed
if ! command -v sqlite3 &> /dev/null; then
  echo "📦 Installing SQLite..."
  sudo rm -f /etc/apt/sources.list.d/yarn.list 2>/dev/null || true
  sudo apt-get update -qq && sudo apt-get install -y sqlite3 libsqlite3-dev -qq
fi

# Ensure all gems are installed
echo "💎 Verifying bundle dependencies..."
bundle check || bundle install

# Ensure database is prepared
echo "🗄️ Preparing SQLite database..."
bin/rails db:prepare && bin/rails db:seed

# Start Rails server
echo "✨ Starting Rails web server on http://0.0.0.0:3000 ..."
exec bin/rails server -b 0.0.0.0
